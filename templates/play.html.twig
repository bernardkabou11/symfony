{% extends 'base.html.twig' %}

{% block title %}Jouer{% endblock %}

{% block body %}
<h1>Bonjour {{ player.name }} 👋</h1>

<p>Devinez un nombre entre <strong>1 et 10</strong>.</p>

<form method="post">
    <label for="guess">Votre choix :</label>
    <input type="number" id="guess" name="guess" min="1" max="10" required>

    <button type="submit">Valider</button>
</form>

<p>Score actuel : <strong>{{ player.score }}</strong></p>
{% endblock %}
